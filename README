│   │   │   ├── data_mem.v          # Data memory (256×32-bit)
│   │   │   ├── instr_mem.v         # Instruction memory (256×32-bit)
│   │   │   └── registers_bank.v    # Register file (32×32-bit)
│   │   └── practices/              # Practice exercises and learning modules
│   │       ├── alu_prac.v          # ALU practice implementation
│   │       ├── controller.v        # Controller practice module
│   │       ├── converter_*.v       # Binary/Gray/OneHot converters
│   │       ├── counter.v           # Counter circuits
│   │       ├── displacer.v         # Barrel shifter
│   │       ├── displacer_reg.v     # Registered shifter
│   │       ├── driver.v            # Driver circuits
│   │       ├── fifo.v              # FIFO memory
│   │       ├── lib.v               # Library functions
│   │       ├── memory.v            # Memory modules
│   │       ├── multiplexor.v       # Multiplexer circuits
│   │       ├── proc_ripple_carry_adder.v  # Procedural adder
│   │       ├── reg_reset.v         # Register with reset
│   │       ├── register.v          # Register modules
│   │       ├── struct_ripple_carry_adder.v # Structural adder
│   │       └── using_function_counter.v   # Counter with functions
│   └── verif/                      # Verification and testing
│       ├── alu_test.sv             # ALU testbench
│       ├── control_unit_test.sv    # Control unit testbench
│       ├── converter_gray_bin_test.sv # Gray converter testbench
│       ├── cpu_top_test.sv         # Main CPU testbench (14+ tests)
│       ├── fifo_test.sv            # FIFO testbench
│       ├── registers_bank_test.sv  # Register file testbench
│       └── assembly/               # Test programs (hex files)
│           ├── regs.hex            # Register initialization test
│           ├── basic_swlw.hex      # Basic store/load operations
│           ├── border_swlw.hex     # Boundary value testing
│           ├── rtype.hex           # R-type ALU operations
│           ├── jump.hex            # Jump instruction test
│           ├── beq.hex             # Branch on Equal test
│           ├── andi.hex            # AND Immediate test
│           ├── ori.hex             # OR Immediate test
│           ├── lui.hex             # Load Upper Immediate test
│           ├── sll.hex             # Shift Left Logical test
│           ├── srl.hex             # Shift Right Logical test
│           ├── bne.hex             # Branch on Not Equal test
│           ├── fibonacci.hex       # Fibonacci sequence test
│           ├── fibonacci_overflow.hex # Fibonacci with overflow
│           └── integration.hex     # Integration test program
└── synth/                          # Synthesis tools and scripts
